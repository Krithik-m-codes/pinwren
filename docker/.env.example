# Public URL people will open (and the widget will call). No trailing slash.
PINWREN_URL=https://feedback.example.com
# openssl rand -base64 48
PINWREN_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Everything below is optional. Every variable in this file reaches the app (compose.yml `env_file`).
#
# First run: open PINWREN_URL and create an account. The first account on a new server is its admin:
# SMTP, security and the licence are configured in the dashboard (Settings). Keep the server private
# (bound to 127.0.0.1, or behind your proxy before the DNS name is public) until that account exists.

# --- Network -------------------------------------------------------------------------------------------
# PINWREN_PORT=3000             # host port
# PINWREN_BIND=127.0.0.1        # 0.0.0.0 to expose without a reverse proxy
# Reverse proxies in front of Pinwren whose X-Forwarded-For to trust (1 = one proxy, e.g. Caddy/nginx;
# 2 = CDN + proxy). 0 = none: the socket address is used. Must match your setup or rate limits break.
# PINWREN_TRUST_PROXY=1
# Redirect plain HTTP to HTTPS and send HSTS (needs PINWREN_TRUST_PROXY behind a TLS proxy).
# PINWREN_ENFORCE_HTTPS=true

# --- Accounts ------------------------------------------------------------------------------------------
# Extra instance administrators, besides the first account (comma-separated emails).
# PINWREN_ADMIN_EMAILS=you@example.com
# Sign-up: unset = only the first account and invited people can sign up; false = anyone; true = no
# open sign-up at all (the first account and invitations still work).
# PINWREN_DISABLE_SIGNUP=false

# --- Email (SMTP) --------------------------------------------------------------------------------------
# Easiest: leave these out and set SMTP in Settings > Email (it has a "Send test email" button). A value
# set here locks that field in the dashboard. Port 587 + SMTP_SECURE=false uses STARTTLS; port 465 +
# SMTP_SECURE=true is TLS from the start.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# EMAIL_FROM="Pinwren <feedback@example.com>"
# Refuse to send unless the server upgrades to TLS (STARTTLS); accept a self-signed certificate.
# SMTP_REQUIRE_TLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Sign in with Google / GitHub -----------------------------------------------------------------------
# Optional. Create an OAuth app with the provider and register the callback URL shown in Settings >
# Security > Sign-in methods (PINWREN_URL/api/auth/callback/google or .../github). Set both values of a
# pair, then restart. Sign-up rules still apply: on an invitation-only server they don't let strangers in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- File storage --------------------------------------------------------------------------------------
# Default: screenshots, replays and project exports live in the pinwren-data volume (/data). For any
# S3-compatible store (AWS S3, Cloudflare R2, MinIO…):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=pinwren
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Limits and outbound requests ----------------------------------------------------------------------
# Private hosts/CIDRs webhooks, panel actions and tracker URLs may reach (internal GitLab, Mattermost…).
# Everything private (10/8, 192.168/16, 127/8, link-local, metadata…) is refused otherwise.
# PINWREN_OUTBOUND_ALLOWLIST=gitlab.internal,*.corp.example,10.20.0.0/16
# Widget reports and replies per visitor address per minute (each project can override it).
# WIDGET_RATE_LIMIT_PER_MIN=10
# Widget intake caps per project, whatever the sender's address.
# WIDGET_PROJECT_REPORTS_PER_MIN=120
# WIDGET_PROJECT_MB_PER_HOUR=500
# PINWREN_INVITES_PER_HOUR=30
# Node processes serving requests; roughly one per CPU core you give the container.
# PINWREN_WORKERS=2

# --- Enterprise ----------------------------------------------------------------------------------------
# PINWREN_LICENSE_FILE=/data/pinwren.lic   # or upload it in Settings > Licence

# --- AI triage (optional; or configure it in Settings > AI, which wins over these) -----------------
# AI_PROVIDER=anthropic        # anthropic | openai | ollama
# AI_MODEL=claude-haiku-5-5
# AI_API_KEY=
# AI_BASE_URL=                 # e.g. http://ollama.internal:11434 (trusted: may be a private address)
# PINWREN_EU_PRIVACY=true      # never send reports to an AI provider
