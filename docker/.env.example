# Public URL people will open (and the widget will call). No trailing slash.
ANNOTA_URL=https://feedback.example.com
# openssl rand -base64 48
ANNOTA_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional
# ANNOTA_PORT=3000             # host port
# ANNOTA_BIND=127.0.0.1        # 0.0.0.0 to expose without a reverse proxy
# ANNOTA_DISABLE_SIGNUP=true   # after your team has signed up
