{
  "name": "@pinwren/sdk",
  "version": "0.1.1",
  "description": "Typed client for the Pinwren REST API (/api/v1): feedback, comments, review rounds",
  "keywords": [
    "pinwren",
    "feedback",
    "bug-report",
    "api-client",
    "sdk",
    "visual-feedback",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Krithik-m-codes (https://github.com/Krithik-m-codes)",
  "homepage": "https://pinwren.xride-labs.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krithik-m-codes/pinwren.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Krithik-m-codes/pinwren/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate-types.ts",
    "prepublishOnly": "tsup"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@pinwren/core": "workspace:*",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
