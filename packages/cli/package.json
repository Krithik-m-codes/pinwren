{
  "name": "@pinwren/cli",
  "version": "0.1.1",
  "description": "Pinwren command line: install the widget, check an instance, list open feedback",
  "keywords": [
    "pinwren",
    "cli",
    "feedback",
    "feedback-widget",
    "doctor",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Krithik-m-codes (https://github.com/Krithik-m-codes)",
  "homepage": "https://pinwren.xride-labs.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krithik-m-codes/pinwren.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Krithik-m-codes/pinwren/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "bin": {
    "pinwren": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@pinwren/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
