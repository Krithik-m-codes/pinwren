{
  "name": "@pinwren/widget",
  "version": "0.1.0",
  "description": "Pinwren feedback widget: Figma-style pinned comments and annotated bug reports for any website",
  "keywords": [
    "feedback",
    "feedback-widget",
    "bug-report",
    "bug-tracking",
    "visual-feedback",
    "annotation",
    "screenshot",
    "website-feedback",
    "user-feedback",
    "qa",
    "self-hosted",
    "pinwren"
  ],
  "license": "MIT",
  "author": "Krithik-m-codes (https://github.com/Krithik-m-codes)",
  "homepage": "https://pinwren.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krithik-m-codes/pinwren.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/Krithik-m-codes/pinwren/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/widget*.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/widget.js",
  "jsdelivr": "./dist/widget.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget.js": "./dist/widget.js",
    "./manifest.json": "./dist/manifest.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepublishOnly": "node build.mjs"
  },
  "devDependencies": {
    "@medv/finder": "^4.0.2",
    "@pinwren/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@rrweb/record": "^2.1.7",
    "@types/node": "^22",
    "@zumer/snapdom": "^3.3.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "vitest": "^5.0.5"
  }
}
