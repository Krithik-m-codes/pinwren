    "cn": "^0.5.0",
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "zod": "^4.6.7"
