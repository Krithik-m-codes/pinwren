DATABASE_URL=postgres://annota:annota@127.0.0.1:5433/annota
ANNOTA_URL=http://localhost:3100
# openssl rand -base64 48
ANNOTA_SECRET=
ANNOTA_DATA_DIR=../../data

# --- Optional -------------------------------------------------------------------
# Instance admins (SMTP settings). Unset: the first user who signed up.
# ANNOTA_ADMIN_EMAILS=you@example.com
# all = serve + run background jobs; web = serve only; worker = jobs only
# ANNOTA_ROLE=all
# ANNOTA_JOBS_POOL_MAX=3

# Email (each variable overrides and locks the matching admin-UI field; unset = emails are skipped)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM="Annota <feedback@example.com>"

# Storage: fs (default, under ANNOTA_DATA_DIR) or any S3-compatible bucket
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=annota
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# WIDGET_RATE_LIMIT_PER_MIN=10
