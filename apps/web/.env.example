DATABASE_URL=postgres://pinwren:pinwren@127.0.0.1:5433/pinwren
PINWREN_URL=http://localhost:3100
# openssl rand -base64 48
PINWREN_SECRET=
PINWREN_DATA_DIR=../../data

# --- Optional -------------------------------------------------------------------
# Deployment mode defaults to selfhost. Cloud requires offline database provisioning first.
# PINWREN_MODE=selfhost
# Cloud only: identity/system connection with no direct access to protected tenant tables.
# PINWREN_SERVICE_DATABASE_URL=postgres://pinwren_service:...@localhost:5432/pinwren
# Migration credentials belong only in the offline provisioning process, never in the running app.
# Instance admins (SMTP settings). Unset: claim it with the one-time setup token the server prints on
# start (open /setup). Signing up first does not make you an admin.
# PINWREN_ADMIN_EMAILS=you@example.com
# Sign-up: unset = first account + invited people only; false = open sign-up (smoke/e2e need this);
# true = closed (first account and invitations still work).
# PINWREN_DISABLE_SIGNUP=false
# all = serve + run background jobs; web = serve only; worker = jobs only
# PINWREN_ROLE=all
# PINWREN_JOBS_POOL_MAX=3

# Email (each variable overrides and locks the matching admin-UI field; unset = emails are skipped)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM="Pinwren <feedback@example.com>"

# Storage: fs (default, under PINWREN_DATA_DIR) or any S3-compatible bucket
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=pinwren
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# WIDGET_RATE_LIMIT_PER_MIN=10
# Per project, whatever the sender's address: reports per minute, stored files per hour, invitations.
# WIDGET_PROJECT_REPORTS_PER_MIN=120
# WIDGET_PROJECT_MB_PER_HOUR=500
# PINWREN_INVITES_PER_HOUR=30

# --- Security -------------------------------------------------------------------
# Redirect/refuse plain-HTTP requests that don't come from localhost. Behind a reverse proxy, also set
# PINWREN_TRUST_PROXY so X-Forwarded-Proto/-Host/-For are believed.
# PINWREN_ENFORCE_HTTPS=false
# Number of reverse proxies in front of Pinwren (true = 1). The client address is the X-Forwarded-For
# entry that many hops from the right; 0/false ignores forwarded headers and uses the socket address.
# PINWREN_TRUST_PROXY=0
# Outbound requests (webhooks, panel actions, tracker URLs) never reach private, loopback, link-local
# or metadata addresses — except hosts/CIDRs listed here (internal GitLab, Mattermost…).
# PINWREN_OUTBOUND_ALLOWLIST=gitlab.internal,*.corp.example,10.20.0.0/16
# Development/tests only: allow every outbound address. Never in production.
# PINWREN_OUTBOUND_ALLOW_PRIVATE=false
# Session lifetime for new sign-ins (1-90 days); setting it here locks Settings > Security.
# PINWREN_SESSION_DAYS=7

# --- Update check (Settings > Security; off on its own while any project uses privacy mode) ---------
# PINWREN_UPDATE_CHECK=true
# PINWREN_UPDATE_REPO=Krithik-m-codes/pinwren
# PINWREN_VERSION=0.1.0

# --- Enterprise licence (Settings > Licence; a file here locks the upload) -------------------------
# PINWREN_LICENSE_FILE=/etc/pinwren/pinwren.lic
# Only for licences bound to one instance:
# PINWREN_INSTANCE_ID=

# --- Issue trackers (per-integration URLs override these: GitHub Enterprise, self-managed GitLab) ---
# GITHUB_API_URL=https://api.github.com
# GITLAB_URL=https://gitlab.com

# Build folder for a second dev server in the same checkout (e.g. tests on another port)
# PINWREN_NEXT_DIST_DIR=.next
