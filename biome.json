{
  "$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-*",
      "!**/dist",
      "!**/drizzle/meta",
      "!apps/web/src/components/ui",
      "!apps/web/src/hooks",
      "!apps/web/public",
      "!**/*.css",
      "!scripts/demo-site",
      "!**/test-results",
      "!**/playwright-report",
      "!**/e2e/.auth"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
