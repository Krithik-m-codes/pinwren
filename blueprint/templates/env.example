# ---------------------------------------------------------------------------
# Annota — environment reference
# Required variables are uncommented. Everything else is optional; most of it
# can also be set in the admin UI (env values override and lock the UI field).
# ---------------------------------------------------------------------------

# --- Core (required) --------------------------------------------------------
ANNOTA_URL=https://feedback.example.com        # public origin of this instance (dashboard + widget API)
DATABASE_URL=postgres://annota:change-me@db:5432/annota
ANNOTA_SECRET=                                  # >= 32 random bytes (openssl rand -base64 48): sessions, CSRF, signing
ANNOTA_ENCRYPTION_KEY=                          # 32 random bytes base64: encrypts secrets at rest
# ANNOTA_ENCRYPTION_KEY_PREVIOUS=               # old key during rotation

# --- Runtime -----------------------------------------------------------------
# ANNOTA_MODE=selfhost                          # selfhost | cloud
# ANNOTA_ROLE=all                               # all | web | worker
# PORT=3000
# ANNOTA_TRUST_PROXY=1                          # behind a reverse proxy
# ANNOTA_LOG_LEVEL=info
# ANNOTA_SETUP_TOKEN=                           # required to run the setup wizard on a public host (printed in logs if unset)
# DATABASE_READ_URL=                            # optional read replica
# REDIS_URL=                                    # optional (Cloud scale): rate limits, SSE fan-out
# ANNOTA_METRICS_TOKEN=                         # protects /metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Storage -------------------------------------------------------------------
# STORAGE_DRIVER=fs                             # fs | s3
# STORAGE_FS_PATH=/data/assets
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=annota
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true                      # MinIO / RustFS / most self-hosted S3
# S3_PUBLIC_BASE_URL=                           # optional CDN in front of the bucket

# --- Email ----------------------------------------------------------------------
# EMAIL_DRIVER=smtp                             # smtp | resend | postmark | none
# EMAIL_FROM="Annota <feedback@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false                             # true for port 465
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# --- Sign-in providers (optional) ----------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ANNOTA_DISABLE_SIGNUP=true                    # self-host: only invited users can join

# --- Integrations (optional; can be set in UI) ------------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# --- AI (optional, off by default) --------------------------------------------------
# AI_PROVIDER=anthropic                         # anthropic | openai-compatible | ollama
# AI_API_KEY=
# AI_BASE_URL=                                  # for openai-compatible / ollama
# AI_MODEL=
# AI_EMBEDDING_MODEL=

# --- Limits & abuse ------------------------------------------------------------------
# WIDGET_RATE_LIMIT_PER_MIN=10
# WIDGET_RATE_LIMIT_PER_HOUR=500
# MAX_UPLOAD_MB=10
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Backups (optional) ----------------------------------------------------------------
# ANNOTA_BACKUP_ENABLED=false
# ANNOTA_BACKUP_CRON="30 3 * * *"
# ANNOTA_BACKUP_S3_ENDPOINT=
# ANNOTA_BACKUP_S3_BUCKET=
# ANNOTA_BACKUP_S3_ACCESS_KEY_ID=
# ANNOTA_BACKUP_S3_SECRET_ACCESS_KEY=
# ANNOTA_BACKUP_RETENTION_DAYS=30

# --- Licensing / telemetry / updates ----------------------------------------------------
# ANNOTA_LICENSE_FILE=/data/annota.lic          # Enterprise self-host
# ANNOTA_TELEMETRY=false
# ANNOTA_UPDATE_CHECK=true

# --- Cloud only --------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ANNOTA_CDN_URL=https://cdn.annota.app
