# ---------------------------------------------------------------------------
# Pinwren — environment reference
# Required variables are uncommented. Everything else is optional; most of it
# can also be set in the admin UI (env values override and lock the UI field).
# ---------------------------------------------------------------------------

# --- Core (required) --------------------------------------------------------
PINWREN_URL=https://feedback.example.com        # public origin of this instance (dashboard + widget API)
DATABASE_URL=postgres://pinwren:change-me@db:5432/pinwren
PINWREN_SECRET=                                  # >= 32 random bytes (openssl rand -base64 48): sessions, signing, and (HKDF-derived) encryption of secrets at rest — rotating it means re-entering SMTP passwords and webhook secrets (ADR 0014)
# PINWREN_ENCRYPTION_KEY=                        # planned: separate at-rest key with rotation (not read yet, ADR 0014)
# PINWREN_ENCRYPTION_KEY_PREVIOUS=               # planned: old key during rotation

# --- Runtime -----------------------------------------------------------------
# PINWREN_MODE=selfhost                          # selfhost | cloud
# PINWREN_CLOUD_SIGNUPS=closed                   # cloud only: open | closed (default closed; the sign-up kill switch)
# PINWREN_CLOUD_SIGNUPS_PER_IP_HOUR=5            # cloud only: new accounts per client address per hour
# PINWREN_CLOUD_SIGNUPS_PER_HOUR=100             # cloud only: new accounts per hour, whole instance
# PINWREN_TERMS_URL=                             # cloud only: sign-up consent links (default: the www legal pages)
# PINWREN_PRIVACY_URL=
# PINWREN_ROLE=all                               # all | web | worker (web: serve only, jobs still enqueued)
# PINWREN_ADMIN_EMAILS=                          # comma-separated instance admins; unset = claim admin once at /setup with the pws_ token printed in the server log
# PINWREN_JOBS_POOL_MAX=3                        # Postgres connections per process for pg-boss
# PORT=3000
# PINWREN_TRUST_PROXY=1                          # behind a reverse proxy
# PINWREN_LOG_LEVEL=info
# PINWREN_SETUP_TOKEN=                           # required to run the setup wizard on a public host (printed in logs if unset)
# DATABASE_READ_URL=                            # optional read replica
# REDIS_URL=                                    # optional (Cloud scale): rate limits, SSE fan-out
# PINWREN_METRICS_TOKEN=                         # protects /metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Storage -------------------------------------------------------------------
# STORAGE_DRIVER=fs                             # fs | s3
# PINWREN_DATA_DIR=/data                         # fs driver writes under <dir>/assets
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=pinwren
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true                      # MinIO / RustFS / most self-hosted S3
# S3_PUBLIC_BASE_URL=                           # planned: optional CDN (assets are streamed through /api/assets today)

# --- Email ----------------------------------------------------------------------
# EMAIL_DRIVER=smtp                             # planned: smtp | resend | postmark | none (only SMTP today; unset SMTP = emails skipped)
# EMAIL_FROM="Pinwren <feedback@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false                             # true for port 465
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# --- Sign-in providers (optional) ----------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PINWREN_DISABLE_SIGNUP=true                    # self-host: only invited users can join

# --- Integrations (optional; can be set in UI) ------------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# --- AI (optional, off by default) --------------------------------------------------
# AI_PROVIDER=anthropic                         # anthropic | openai-compatible | ollama
# AI_API_KEY=
# AI_BASE_URL=                                  # for openai-compatible / ollama
# AI_MODEL=
# AI_EMBEDDING_MODEL=

# --- Limits & abuse ------------------------------------------------------------------
# WIDGET_RATE_LIMIT_PER_MIN=10
# WIDGET_RATE_LIMIT_PER_HOUR=500
# MAX_UPLOAD_MB=10
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Backups (optional) ----------------------------------------------------------------
# PINWREN_BACKUP_ENABLED=false
# PINWREN_BACKUP_CRON="30 3 * * *"
# PINWREN_BACKUP_S3_ENDPOINT=
# PINWREN_BACKUP_S3_BUCKET=
# PINWREN_BACKUP_S3_ACCESS_KEY_ID=
# PINWREN_BACKUP_S3_SECRET_ACCESS_KEY=
# PINWREN_BACKUP_RETENTION_DAYS=30

# --- Licensing / telemetry / updates ----------------------------------------------------
# PINWREN_LICENSE_FILE=/data/pinwren.lic          # Enterprise self-host
# PINWREN_TELEMETRY=false
# PINWREN_UPDATE_CHECK=true

# --- Cloud only --------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PINWREN_CDN_URL=https://cdn.pinwren.app
